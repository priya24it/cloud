import csv

import requests

from utils import logger


class ReindexEntities(ReltioBase):
    """Read entity IDs from a CSV and submit a reindex request."""

    def __init__(
        self,
        csv_file: str,
        *,
        entity_type: str,
        reltio_col: str = "reltio_id",
        delimiter: str = "|",
    ):
        super().__init__()

        if not entity_type.strip():
            raise ValueError("entity_type must not be empty.")

        if len(delimiter) != 1:
            raise ValueError("delimiter must be one character.")

        self.entity_type = entity_type.strip()
        self.reltio_col = reltio_col
        self.delimiter = delimiter

        # Automatically read the CSV and send the request.
        self.response = self.post_payload(csv_file)

    def post_payload(self, csv_file: str) -> requests.Response:
        payload = []

        with open(
            csv_file,
            "r",
            newline="",
            encoding="utf-8-sig",
        ) as file:
            reader = csv.DictReader(file, delimiter=self.delimiter)

            if not reader.fieldnames:
                raise ValueError("CSV has no header row.")

            if self.reltio_col not in reader.fieldnames:
                raise ValueError(
                    f"Missing CSV column: {self.reltio_col}. "
                    f"Found: {reader.fieldnames}"
                )

            for row_number, row in enumerate(reader, start=2):
                entity = (row.get(self.reltio_col) or "").strip()

                if not entity:
                    logger.warning(
                        f"Skipping row {row_number}: missing entity ID."
                    )
                    continue

                # Accept either an ID or an existing entity URI.
                entity_uri = (
                    entity
                    if entity.startswith("entities/")
                    else f"entities/{entity}"
                )

                if (
                    not entity_uri.removeprefix("entities/")
                    or entity_uri.count("/") != 1
                ):
                    raise ValueError(
                        f"Invalid entity ID or URI at row {row_number}."
                    )

                payload.append(entity_uri)

        if not payload:
            raise ValueError(
                "CSV contains no valid entities. No request was sent."
            )

        # Reuse authentication from ReltioBase.
        self.authenticate_to_reltio_api()

        # Build the endpoint here using inherited tenant settings.
        reindex_url = (
            f"https://{self.tenant_name}.reltio.com"
            f"/reltio/api/{self.tenant_id}/reindex"
        )

        logger.info(
            f"Submitting {len(payload)} entities "
            f"for entity type {self.entity_type}."
        )

        response = requests.post(
            url=reindex_url,
            params={
                "tenantId": self.tenant_id,
                "updateEntities": "true",
                "entityType": self.entity_type,
            },
            headers=self.base_headers,
            json=payload,
            timeout=60,
        )

        logger.info(f"Reindex HTTP status: {response.status_code}")
        response.raise_for_status()

        return response
